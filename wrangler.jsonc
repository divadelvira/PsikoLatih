{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "psikotest",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-11-01",
  "kv_namespaces": [
    // Replace with the id from `npx wrangler kv namespace create DATA`.
    { "binding": "DATA", "id": "REPLACE_WITH_KV_ID" }
  ]
}
